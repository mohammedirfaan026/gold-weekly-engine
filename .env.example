# Environment variables for Gold Weekly Response Engine
# Optional API Keys:
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=
# Optional news enrichment (RSS works with no keys; these add more wires):
FINNHUB_API_KEY=
NEWS_API_KEY=
LOG_LEVEL=INFO

# Telegram delivery of Friday brief
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Private read-only dashboard (required before exposing port)
DASHBOARD_PASSWORD=
DASHBOARD_SECRET_KEY=
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8787
DASHBOARD_PUBLIC_URL=http://127.0.0.1:8787
DASHBOARD_DEBUG=0
